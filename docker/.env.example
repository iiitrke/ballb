# Copy to docker/.env to change any of these. Without docker/.env, these defaults are used.
# Local development only: never reuse these passwords on staging or production.

# Host ports (published on 127.0.0.1 only)
POSTGRES_PORT=5433
MAILPIT_WEB_PORT=8025
MAILPIT_SMTP_PORT=1025

# Postgres superuser
POSTGRES_PASSWORD=postgres

# One user per service; each service's dev profile uses the same default
IDENTITY_DB_PASSWORD=identity
CURRICULUM_DB_PASSWORD=curriculum
GLOSSARY_DB_PASSWORD=glossary
SITE_DB_PASSWORD=site
NOTIFICATION_DB_PASSWORD=notification
