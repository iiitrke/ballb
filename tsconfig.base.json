{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "module": "preserve",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "importHelpers": true,
    "isolatedModules": true,
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@ballb/curriculum/data-access": ["libs/curriculum/data-access/src/index.ts"],
      "@ballb/curriculum/feature": ["libs/curriculum/feature/src/index.ts"],
      "@ballb/glossary/feature": ["libs/glossary/feature/src/index.ts"],
      "@ballb/shared/ui": ["libs/shared/ui/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
